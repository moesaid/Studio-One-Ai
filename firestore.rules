rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Projects — users can only access their own projects
    match /projects/{projectId} {
      allow create: if request.auth != null
                    && request.resource.data.owner_id == request.auth.uid;
      allow read, update, delete: if request.auth != null
                                  && resource.data.owner_id == request.auth.uid;

      // Chapters subcollection — same owner check via parent project
      match /chapters/{chapterId} {
        allow read, write: if request.auth != null
                           && get(/databases/$(database)/documents/projects/$(projectId)).data.owner_id == request.auth.uid;
      }

      // Characters subcollection — same owner check via parent project
      match /characters/{characterId} {
        allow read, write: if request.auth != null
                           && get(/databases/$(database)/documents/projects/$(projectId)).data.owner_id == request.auth.uid;
      }

      // Scenes subcollection — same owner check via parent project
      match /scenes/{sceneId} {
        allow read, write: if request.auth != null
                           && get(/databases/$(database)/documents/projects/$(projectId)).data.owner_id == request.auth.uid;
      }

      // Video clips subcollection — same owner check via parent project
      match /video_clips/{clipId} {
        allow read, write: if request.auth != null
                           && get(/databases/$(database)/documents/projects/$(projectId)).data.owner_id == request.auth.uid;
      }
    }
  }
}
