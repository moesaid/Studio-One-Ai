rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    // Project assets — authenticated users can read/write
    match /projects/{projectId}/{allPaths=**} {
      allow read, write: if request.auth != null;
    }

    // Default deny everything else
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
